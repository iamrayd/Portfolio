# Contact form delivery (https://resend.com). Both are required for the form to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you verified in Resend. Defaults to onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# Aim trainer leaderboard (Upstash Redis). Vercel's Upstash integration sets these for you.
# Without them the game still works in production, but scores aren't saved.
# In local development an in-memory store is used instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: raises the GitHub API rate limit for the live repo stats.
GITHUB_TOKEN=

# Optional: canonical URL for metadata. Vercel's production URL is used when unset.
NEXT_PUBLIC_SITE_URL=
